# =============================================================================
# Lab 3 — REMEDIATED image (Section 3.4, Step 2).
#
# Build with:  docker build -f Dockerfile.secure -t todo-app:secure .
# Verify with: trivy image todo-app:secure
#
# What changed vs. Dockerfile:
#   * Multi-stage build → build tools (gcc, headers) never ship in the runtime.
#   * python:3.11-slim base → far fewer OS packages = far fewer CVEs.
#   * No hardcoded secret — SECRET_KEY is injected at runtime via the env.
#   * Runs as an unprivileged user (uid/gid 999), matching Lab 4's
#     securityContext runAsUser: 999.
# =============================================================================

# Stage 1: build dependencies
FROM python:3.11-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc python3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: final secure runtime image
FROM python:3.11-slim
WORKDIR /app

# Create an unprivileged user to execute the application.
RUN groupadd -g 999 appuser && useradd -r -u 999 -g appuser appuser

COPY --from=builder /root/.local /home/appuser/.local
COPY --chown=appuser:appuser app/ /app

ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER appuser
EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "todo.wsgi:application"]
